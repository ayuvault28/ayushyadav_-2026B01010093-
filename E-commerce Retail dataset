        "# 1. Month aur Year columns nikalna\n",
        "df_clean[\"Year\"] = df_clean[\"InvoiceDate\"].dt.year\n",
        "df_clean[\"Month\"] = df_clean[\"InvoiceDate\"].dt.to_period(\"M\")\n",
        "\n",
        "# 2. Country-wise revenue aur order summary (groupby + agg)\n",
        "country_summary = (\n",
        "    df_clean.groupby(\"Country\")\n",
        "    .agg(\n",
        "        total_revenue=(\"TotalAmount\", \"sum\"),\n",
        "        total_quantity=(\"Quantity\", \"sum\"),\n",
        "        unique_orders=(\"InvoiceNo\", \"nunique\"),\n",
        "        unique_customers=(\"CustomerID\", \"nunique\"),\n",
        "    )\n",
        "    .sort_values(\"total_revenue\", ascending=False)\n",
        ")\n",
        "\n",
        "print(\"--- Top 10 Countries by Revenue ---\")\n",
        "print(country_summary.head(10))\n",
        "\n",
        "# 3. Top 10 Products by Total Revenue\n",
        "top_products_rev = (\n",
        "    df_clean.groupby(\"Description\")\n",
        "    .agg(\n",
        "        total_revenue=(\"TotalAmount\", \"sum\"),\n",
        "        total_quantity=(\"Quantity\", \"sum\"),\n",
        "    )\n",
        "    .sort_values(\"total_revenue\", ascending=False)\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "print(\"\\n--- Top 10 Products by Revenue ---\")\n",
        "print(top_products_rev)\n",
        "\n",
        "# 4. Month-wise Revenue Trend\n",
        "monthly_sales = (\n",
        "    df_clean.groupby(\"Month\")\n",
        "    .agg(\n",
        "        monthly_revenue=(\"TotalAmount\", \"sum\"),\n",
        "        orders=(\"InvoiceNo\", \"nunique\"),\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\n--- Monthly Revenue Trend ---\")\n",
        "print(monthly_sales)\n",
        "\n",
        "# 5. Clean dataset CSV save karna (optional)\n",
        "df_clean.to_csv(\"cleaned_ecommerce_data.csv\", index=False)\n",
        "print(\"\\nSaved cleaned_ecommerce_data.csv successfully!\")"
      ]
